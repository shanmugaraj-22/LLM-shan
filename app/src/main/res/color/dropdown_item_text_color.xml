<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed / activated -> use primary color to indicate selection -->
    <item android:state_pressed="true" android:color="?attr/colorPrimary" />
    <item android:state_activated="true" android:color="?attr/colorPrimary" />
    <!-- Default: use onSurface which adapts to light/dark themes -->
    <item android:color="?attr/colorOnSurface" />
</selector>
