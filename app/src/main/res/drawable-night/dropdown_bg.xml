<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Large shadow layer -->
    <item android:top="6dp" android:left="2dp" android:right="2dp" android:bottom="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#88000000" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    
    <!-- Medium shadow layer for depth -->
    <item android:top="3dp" android:left="1dp" android:right="1dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#66000000" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Main surface on top - dark mode override -->
    <item>
        <shape android:shape="rectangle">
            <!-- Use explicit dark background for night mode -->
            <solid android:color="#333333" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#33000000" />
        </shape>
    </item>
</layer-list>
 
